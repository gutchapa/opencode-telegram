{
  "name": "gutchapa-opencode-telegram",
  "version": "1.0.9",
  "description": "Telegram bot for opencode: chat with your local AI assistant over Telegram, with 70+ slash commands",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "default": "./dist/plugin.mjs"
    },
    "./standalone": "./dist/index.js"
  },
  "bin": {
    "opencode-telegram-bot": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/make-plugin-mjs.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "status": "bash scripts/status.sh"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "telegram",
    "bot",
    "agent",
    "llm",
    "assistant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gutchapa/opencode-telegram.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
